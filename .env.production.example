# Copie de travail pour le VPS OVH : cp .env.production.example .env
# puis renseigner chaque valeur. Ce fichier est lu par docker compose
# (env_file) ET sert de source aux variables ${...} du docker-compose.yml.

# --- Docker / MySQL (utilisées par docker-compose.yml) ---
# Mots de passe forts, générés par ex. avec : openssl rand -base64 24
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Serveur ---
NODE_ENV=production
PORT=3000

# --- Base de données (OBLIGATOIRE) ---
# Chaîne de connexion lue par l'application. Sans elle, le backend ne démarre
# pas. Avec le docker-compose fourni, l'hôte est le service `db` et le mot de
# passe doit correspondre à MYSQL_PASSWORD ci-dessus :
#   mysql://customizer:<MYSQL_PASSWORD>@db:3306/customizer
# (docker-compose.yml la construit déjà pour vous ; renseignez-la ici seulement
#  si vous lancez l'application hors compose, ou avec une base externe.)
# `DATABASE_URL` est accepté comme alias.
MYSQL_URL=

# Signature des cookies de session admin. FACULTATIF : s'il est absent, un
# secret aléatoire est généré au premier démarrage et conservé en base, donc
# les sessions survivent aux redémarrages. Le définir ici permet de le
# maîtriser (rotation, plusieurs instances) :
#   openssl rand -hex 32
# Le changer invalide toutes les sessions admin en cours.
ADMIN_SESSION_SECRET=

# Signature des jetons de panier (routes publiques /api/cart). FACULTATIF :
# s'il est absent, un secret aléatoire est généré au premier démarrage et
# conservé en base, donc les paniers ouverts survivent aux redémarrages.
#   openssl rand -hex 32
# Le changer invalide les paniers en cours (le client repart d'un panier vide).
CART_TOKEN_SECRET=

# Compte admin créé au TOUT PREMIER démarrage (base vide). Si le mot de passe
# est laissé vide, il est tiré au hasard et affiché UNE SEULE FOIS dans les
# logs : docker compose logs api | grep "MOT DE PASSE"
ADMIN_SEED_EMAIL=admin@customizer.com
ADMIN_SEED_PASSWORD=

# Création du schéma : mettre à "true" UNIQUEMENT au premier démarrage
# (base vide) pour que TypeORM crée les tables, puis repasser à "false"
# et redémarrer. Laisser actif risque de détruire des colonnes/données
# lors d'un changement d'entité.
DB_SYNCHRONIZE=false
#
# MISE À JOUR D'UNE BASE EXISTANTE : la révocation de session ajoute une
# colonne. Sur une base déjà en service (DB_SYNCHRONIZE=false), exécutez une
# seule fois, AVANT de déployer :
#   ALTER TABLE admins ADD COLUMN passwordChangedAt DATETIME NULL;
# Sans elle, le backend démarre mais toute lecture de compte admin échoue.

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Shopify ---
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-access-token
SHOPIFY_API_VERSION=2024-01

# Clé de signature des webhooks, fournie par Shopify à la création du webhook
# (Paramètres → Notifications → Webhooks). OBLIGATOIRE : sans elle, tous les
# webhooks entrants sont REJETÉS (avant, ils étaient acceptés sans
# vérification, ce qui permettait d'écraser de vraies commandes).
SHOPIFY_WEBHOOK_SECRET=

# --- Email ---
# Aucune variable : le backend n'envoie plus d'e-mail. Toute la correspondance
# client part de Shopify (confirmation de commande, facture du brouillon de
# devis, relances, avis d'expedition). L'equipe suit les nouveaux devis et
# commandes via le dashboard (compteurs « nouveau »).

# --- Frontend (CORS) ---
FRONTEND_URL=https://your-store.myshopify.com

# --- Uploads ---
MAX_FILE_SIZE=10485760
