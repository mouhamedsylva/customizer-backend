# Server
NODE_ENV=development
PORT=3000
API_SECRET_KEY=your-secret-key-here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Shopify Configuration
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-access-token
SHOPIFY_API_VERSION=2024-01

# Aucune configuration SMTP : le backend n'envoie plus d'e-mail. Toute la
# correspondance client (confirmation de commande, facture de devis, relances,
# expedition) part de Shopify.

# Frontend URL (CORS)
FRONTEND_URL=https://your-store.myshopify.com

# Upload Limits
MAX_FILE_SIZE=10485760
MAX_FILES=5

# Pricing API (optionnel si calcul externe)
PRICING_API_URL=
