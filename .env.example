# Server
NODE_ENV=development
PORT=3000

# Base de donnees (OBLIGATOIRE) : sans elle, le backend ne demarre pas.
# `DATABASE_URL` est accepte comme alias.
MYSQL_URL=mysql://root:password@localhost:3306/customizer

# Creation du schema : "true" UNIQUEMENT au premier demarrage sur base vide,
# puis repasser a "false". Laisser actif expose a des ALTER/DROP automatiques.
DB_SYNCHRONIZE=false

# Signature des cookies de session admin et des jetons de panier. Facultatifs :
# un secret aleatoire est genere et conserve en base s'ils sont absents.
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
CART_TOKEN_SECRET=

# Compte admin cree au tout premier demarrage (base vide). Mot de passe vide =
# tire au hasard et affiche UNE SEULE FOIS dans les logs.
ADMIN_SEED_EMAIL=admin@customizer.com
ADMIN_SEED_PASSWORD=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Shopify Configuration
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-access-token
SHOPIFY_API_VERSION=2024-01

# Cle de signature des webhooks, fournie par Shopify. OBLIGATOIRE : sans elle,
# tous les webhooks entrants sont REJETES (401) et les commandes ne remontent
# plus qu'au rythme de la synchro periodique.
SHOPIFY_WEBHOOK_SECRET=

# Aucune configuration SMTP : le backend n'envoie plus d'e-mail. Toute la
# correspondance client (confirmation de commande, facture de devis, relances,
# expedition) part de Shopify.

# Frontend URL (CORS)
FRONTEND_URL=https://your-store.myshopify.com

# Upload Limits
MAX_FILE_SIZE=10485760
